# For usage with Create React App, env variables needs to be prefixed with `REACT_APP_`
# This file is used by `npm run build` (the build Vercel runs for deployments).

# Server namespace
REACT_APP_HOST_URI=https://publish-p220753-e2271497.adobeaemcloud.com/

# Graphql endpoint namespace
REACT_APP_GRAPHQL_ENDPOINT=riyadh

# The ability to disable CACHING is ONLY for demo purposes. You should NEVER disable caching in production. Setting this to true will add cache-busting parameters to the AEM Headless API request.
# Production-use CACHE and TTL can be configured as PersistedQuery header in AEM
REACT_APP_DISABLE_CACHE=true

# On Vercel, use the reverse proxy so GraphQL requests stay same-origin (relative URLs
# rewritten to the AEM host by vercel.json). This avoids cross-origin calls from the
# deployed domain.
REACT_APP_USE_PROXY=true

#AUTH (Choose one method)
# Authentication methods: 'service-token', 'dev-token', 'basic' or leave blank to use no authentication
REACT_APP_AUTH_METHOD=
